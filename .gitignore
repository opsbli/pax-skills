# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.coverage
htmlcov/

# Editors
.vscode/
.idea/
.DS_Store

# Local artifacts
*.log
# 只忽略 tools/ 的内容，不忽略目录本身——否则下方的反忽略规则永远不生效
# （目录被整体排除时，Git 不会 descend 进入目录去看子级规则）。
tools/*
# 例外：quality_gate.py 是自研质量门禁（不是上游 vendored 工具），
# 必须入库，否则 quality-gate job 的 assert 步骤必然失败。
!tools/quality_gate.py

# Proma / session context (not versioned)
.context/

# Proma skill 导入元数据（本地环境状态，不入库）
skills/**/.source.json

# 本地工具状态
.workbuddy/
