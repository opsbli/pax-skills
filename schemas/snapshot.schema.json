{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pax.family/schemas/snapshot.schema.json",
  "title": "pax-snapshot",
  "description": "Single source of truth exchanged between pax-* skills.",
  "type": "object",
  "required": ["meta", "goal", "consensus", "orchestration"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["version", "created_at", "updated_at", "skill_lineage"],
      "additionalProperties": false,
      "properties": {
        "version": {"type": "number", "const": 2.0},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "skill_lineage": {
          "type": "array",
          "items": {"type": "string", "pattern": "^pax-[a-z][a-z0-9-]*$"}
        }
      }
    },
    "goal": {
      "type": "object",
      "required": ["statement", "success_criteria"],
      "additionalProperties": false,
      "properties": {
        "statement": {"type": "string", "minLength": 1},
        "success_criteria": {"type": "array", "items": {"type": "string"}}
      }
    },
    "consensus": {
      "type": "object",
      "required": ["required_precision", "dimensions", "design_tree", "gaps_remaining"],
      "additionalProperties": false,
      "properties": {
        "required_precision": {"type": "string", "enum": ["low", "medium", "high"]},
        "dimensions": {"type": "object"},
        "design_tree": {"type": "array"},
        "gaps_remaining": {"type": "array"},
        "requirements_gaps": {"type": "array"},
        "resolutions": {"type": "array"},
        "settled_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "orchestration": {
      "type": "object",
      "required": ["diagnose_required", "rationale", "skip_reason",
                   "route", "question_strategy",
                   "intent", "risk", "annotations"],
      "additionalProperties": false,
      "properties": {
        "diagnose_required": {"type": "boolean"},
        "rationale": {"type": "string"},
        "skip_reason": {"type": ["string", "null"]},
        "route": {"type": "array", "items": {"type": "string"}},
        "question_strategy": {"type": "string",
                                "enum": ["batch", "one-by-one"]},
        "intent": {
          "type": "object",
          "required": ["primary", "secondary", "classification_rationale"],
          "additionalProperties": false,
          "properties": {
            "primary": {
              "type": "string",
              "enum": ["diagnose_fix", "feature_dev", "refactor",
                       "data_ops", "doc_consult", "tool_build"]
            },
            "secondary": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["performance", "security", "data_integrity",
                         "ux_error", "integration", "deployment"]
              }
            },
            "classification_rationale": {"type": "string"}
          }
        },
        "risk": {
          "type": "object",
          "required": ["irreversibility", "impact_scope", "uncertainty",
                       "coordination_cost", "total", "level",
                       "forced_escalation"],
          "additionalProperties": false,
          "properties": {
            "irreversibility": {"type": "integer", "minimum": 1, "maximum": 3},
            "impact_scope": {"type": "integer", "minimum": 1, "maximum": 3},
            "uncertainty": {"type": "integer", "minimum": 1, "maximum": 3},
            "coordination_cost": {"type": "integer", "minimum": 1, "maximum": 3},
            "total": {"type": "integer", "minimum": 4, "maximum": 12},
            "level": {"type": "string", "enum": ["low", "medium", "high"]},
            "forced_escalation": {"type": "boolean"}
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "escalate_to_council": {"type": "boolean"},
            "council_trigger": {"type": ["string", "null"]},
            "storage_backend_required": {"type": "boolean"},
            "script_language_required": {"type": "boolean"},
            "cross_repo": {"type": "boolean"},
            "execution_strategy_required": {"type": "boolean"},
            "involved_repos": {"type": "array", "items": {"type": "string"}},
            "frontend_involved": {"type": "boolean"},
            "performance_metrics_required": {"type": "boolean"},
            "integration_contract_required": {"type": "boolean"},
            "deployment_env_required": {"type": "boolean"},
            "analysis_optional_docs": {"type": "boolean"}
          }
        }
      }
    },
    "symptom": {
      "type": "object",
      "required": ["description", "impact", "reproduction", "first_observed"],
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string"},
        "impact": {"type": "string"},
        "reproduction": {"type": "string"},
        "first_observed": {"type": "string", "format": "date-time"},
        "recent_changes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "diagnosis": {"type": "object"},
    "infrastructure": {
      "type": "object",
      "description": "环境事实（非需求、非决策）。storage_backend 为数据类任务的强制确认项。",
      "additionalProperties": true,
      "properties": {
        "storage_backend": {"type": ["string", "null"]},
        "script_language": {"type": ["string", "null"]},
        "target_environment": {"type": ["string", "null"]}
      }
    },
    "plan": {
      "type": "object",
      "required": ["steps", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": ["string", "null"],
               "description": "本计划的唯一标识，供 pax-rollback 等下游定位被回滚的对象。"},
        "steps": {"type": "array"},
        "dependencies": {"type": "array"},
        "evidence": {"type": "array"},
        "verification_strategy": {"type": "array"},
        "status": {"type": "string", "enum": ["draft", "frozen"]},
        "frozen_at": {"type": ["string", "null"], "format": "date-time"},
        "frozen_by": {"type": ["string", "null"]},
        "rollback_strategy": {
          "type": "object",
          "description": "按触发原因分档的回滚策略；pax-rollback 的门禁输入。",
          "additionalProperties": false,
          "properties": {
            "on_failure": {"type": ["string", "array", "null"]},
            "on_alert": {"type": ["string", "array", "null"]},
            "on_request": {"type": ["string", "array", "null"]},
            "default": {"type": ["string", "array", "null"]}
          }
        }
      }
    },
    "contract": {
      "type": "object",
      "required": ["authorization", "constraints", "exceptions",
                   "assumptions", "withdraw"],
      "additionalProperties": false,
      "properties": {
        "authorization": {"type": "object"},
        "constraints": {"type": "array"},
        "exceptions": {"type": "array"},
        "assumptions": {"type": "array"},
        "withdraw": {"type": "array"}
      }
    },
    "execution": {
      "type": "object",
      "required": ["mode", "log", "deviations", "changes", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": ["string", "null"],
               "description": "本次执行的唯一标识，供 pax-rollback 等下游定位被回滚的对象。"},
        "mode": {"type": "string", "enum": ["normal", "fix"]},
        "status": {"type": "string",
                   "enum": ["completed", "failed", "paused"]},
        "completed_at": {"type": ["string", "null"], "format": "date-time"},
        "log": {"type": "array"},
        "deviations": {"type": "array"},
        "changes": {"type": "array"},
        "commits": {"type": "array"}
      }
    },
    "review": {
      "type": "object",
      "required": ["verdict", "stamp", "rationale"],
      "additionalProperties": false,
      "properties": {
        "verdict": {"type": "string",
                    "enum": ["verified", "needs_fix", "partial", "blocked", "needs_review"]},
        "stamp": {
          "type": ["string", "null"],
          "description": "评审所依据的 verify 印章引用（对应 quality.verification_seals 中的 seal id）。"
        },
        "rationale": {"type": "string"},
        "findings": {"type": "array"},
        "verification_results": {"type": "array"},
        "deviations_check": {"type": "object"},
        "stamp_check": {"type": "object"},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "reviewed_by": {"type": ["string", "null"]}
      }
    },
    "quality": {
      "type": "object",
      "required": ["verification_seals", "evolution_entries"],
      "additionalProperties": false,
      "properties": {
        "verification_seals": {
          "type": "array",
          "description": "pax-verify 追加的印章序列；pax-review 读取最后一条作为门禁输入。",
          "items": {
            "type": "object",
            "required": ["result"],
            "additionalProperties": true,
            "properties": {
              "result": {"type": "string",
                         "enum": ["verified", "needs_fix", "partial", "blocked", "needs_review"]},
              "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
              "attempts": {"type": "integer"},
              "duration": {"type": "string"},
              "evidence": {"type": "array"},
              "summary": {"type": "string"}
            }
          }
        },
        "evolution_entries": {"type": "array"}
      }
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {"type": ["string", "null"]},
        "config": {"type": "object"},
        "thresholds": {"type": "object"},
        "alerts_triggered": {"type": "array"},
        "logs": {"type": "array"},
        "summary": {"type": ["string", "null"]}
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {"type": ["string", "null"]},
        "trigger_reason": {"type": ["string", "null"]},
        "strategy": {"type": ["string", "null"]},
        "steps": {"type": "array"},
        "verification": {"type": "object"},
        "summary": {"type": ["string", "null"]}
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {"type": ["string", "null"]},
        "summary": {"type": ["string", "null"]},
        "coverage": {"type": "object"},
        "failed_tests": {"type": "array"},
        "recommendations": {"type": "array"},
        "pie_check": {"type": "array"}
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {"type": ["string", "null"]},
        "strategy": {"type": ["string", "null"]},
        "environment": {"type": ["string", "null"]},
        "steps": {"type": "array"},
        "pre_checks": {"type": "array"},
        "health_checks": {"type": "array"},
        "summary": {"type": ["string", "null"]}
      }
    },
    "learning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "experiences": {"type": "array"},
        "knowledge_graph": {"type": "object"},
        "recommendations": {"type": "array"}
      }
    },
    "design": {
      "type": "object",
      "description": "pax-design 写入的设计契约段。consensus 由澄清阶段独占，本段承载 clarify 之后、plan 之前的设计决策。",
      "additionalProperties": false,
      "properties": {
        "design_required": {"type": "boolean"},
        "skip_reason": {"type": ["string", "null"]},
        "depth": {"type": "string", "enum": ["minimal", "standard", "full"]},
        "candidates": {
          "type": "array",
          "description": "方案候选；full 深度的高风险决策至少 2 个。",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "additionalProperties": true,
            "properties": {
              "id": {"type": "string"},
              "name": {"type": "string"},
              "approach": {"type": "string"},
              "pros": {"type": "array"},
              "cons": {"type": "array"},
              "evidence": {"type": "array"},
              "costs": {"type": "array"}
            }
          }
        },
        "adrs": {
          "type": "array",
          "description": "架构决策记录；不可逆或跨边界决策必须留痕，含代价与后果。",
          "items": {
            "type": "object",
            "required": ["id", "title", "status"],
            "additionalProperties": true,
            "properties": {
              "id": {"type": "string"},
              "title": {"type": "string"},
              "status": {"type": "string",
                         "enum": ["proposed", "accepted", "superseded"]},
              "context": {"type": "string"},
              "decision": {"type": "string"},
              "alternatives": {"type": "array"},
              "consequences": {"type": "object"},
              "supersedes": {"type": ["string", "null"]},
              "decided_at": {"type": ["string", "null"], "format": "date-time"}
            }
          }
        },
        "api_contracts": {
          "type": "array",
          "description": "可被计划阶段直接消费的接口契约；错误码与触发条件成对出现。",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": true,
            "properties": {
              "name": {"type": "string"},
              "method": {"type": "string",
                         "enum": ["GET", "POST", "PUT", "DELETE", "PATCH"]},
              "path": {"type": "string"},
              "request": {"type": "string"},
              "response": {"type": "string"},
              "error_codes": {"type": "array"},
              "auth": {"type": "string"},
              "version": {"type": "string"}
            }
          }
        },
        "data_models": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": true,
            "properties": {
              "name": {"type": "string"},
              "fields": {"type": "array"},
              "relationships": {"type": "array"},
              "indexes": {"type": "array"}
            }
          }
        },
        "service_boundaries": {
          "type": "array",
          "description": "depends_on 必须构成有向无环图。",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": true,
            "properties": {
              "name": {"type": "string"},
              "responsibility": {"type": "string"},
              "depends_on": {"type": "array"},
              "exposes": {"type": "array"}
            }
          }
        },
        "observability_plan": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "logs": {"type": "array"},
            "metrics": {"type": "array"},
            "traces": {"type": "array"},
            "slo": {"type": "array"}
          }
        },
        "security_considerations": {"type": "array"},
        "review": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required": {"type": "boolean"},
            "verdict": {"type": ["string", "null"],
                        "enum": ["accepted", "needs_revision", "blocked", null]},
            "round": {"type": "integer"}
          }
        },
        "open_questions": {"type": "array"},
        "status": {"type": "string", "enum": ["draft", "frozen", "blocked"]},
        "frozen_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "findings": {"type": "array"},
        "conclusion": {"type": "string"},
        "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
        "open_questions": {"type": "array"},
        "read_only": {"type": "boolean"}
      }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "question": {"type": "string"},
        "scope": {"type": "string"},
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "url": {"type": "string"},
              "type": {"type": "string"},
              "credibility": {"type": "string", "enum": ["high", "medium", "low"]}
            }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "id": {"type": "string"},
              "claim": {"type": "string"},
              "evidence": {"type": "string"},
              "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
              "is_inference": {"type": "boolean"}
            }
          }
        },
        "competitors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "name": {"type": "string"},
              "features": {"type": "array"},
              "positioning": {"type": "string"}
            }
          }
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "option": {"type": "string"},
              "pros": {"type": "array"},
              "cons": {"type": "array"},
              "evidence": {"type": "array"}
            }
          }
        },
        "recommendation_candidate": {"type": "string"},
        "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
        "open_questions": {"type": "array"},
        "read_only": {"type": "boolean"}
      }
    },
    "prd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "type": {"type": "string"},
            "path": {"type": "string"}
          }
        },
        "pages": {"type": "array"},
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "id": {"type": "string"},
              "module": {"type": "string"},
              "priority": {"type": "string", "enum": ["must", "should", "could"]}
            }
          }
        },
        "functional_requirements": {"type": "array"},
        "acceptance_criteria": {"type": "array"},
        "data_dictionary": {"type": "array"},
        "scope": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "in": {"type": "array"},
            "out": {"type": "array"}
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "verdict": {"type": "string", "enum": ["PASS", "NEEDS_WORK", "FAIL"]},
            "findings": {"type": "array"}
          }
        },
        "change": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "change_id": {"type": "string"},
            "change_type": {"type": "string", "enum": ["create", "update", "no_action"]},
            "impact_analysis": {"type": "array"},
            "status": {"type": "string", "enum": ["pending_approval", "approved", "applied"]}
          }
        }
      }
    }
  }
}
